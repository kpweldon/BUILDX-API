# Copy to .env for local dev. Never commit .env.
# In GitHub Actions, set these as repository secrets instead.

DESCRIPT_API_KEY=your_descript_api_key_here

# Optional: override if Descript publishes a different base URL for your account
DESCRIPT_API_BASE_URL=https://api.descript.com

# Optional: where batch jobs write output
OUTPUT_DIR=./out

# Google Drive upload (optional — leave blank to skip the upload step)
# 1. Run `python scripts/setup_drive_auth.py` once locally to produce the JSON blob.
# 2. Paste the JSON contents into GOOGLE_OAUTH_CREDS as a GitHub repo secret.
# 3. Set DRIVE_FOLDER_ID to the ID from the Drive folder URL
#    (e.g. https://drive.google.com/drive/folders/<THIS_PART>).
GOOGLE_OAUTH_CREDS=
DRIVE_FOLDER_ID=
